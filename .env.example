# Copy to .env.local (gitignored) and fill in the keys you have. Every just
# recipe loads .env.local; each key is optional, and eval-matrix skips the
# models whose key is missing. A key exported in the shell wins over this file.

# Anthropic Claude models.
ANTHROPIC_API_KEY=

# OpenAI GPT-6 Luna.
OPENAI_API_KEY=

# Google Gemini 3.6 Flash.
GOOGLE_API_KEY=

# Open models (Qwen3.8, GLM-5.3, DeepSeek V4) on Together AI, and the default
# grader (GLM-5.3), so every API-backed recipe needs this key.
TOGETHER_API_KEY=

# The same open models on Hugging Face's inference router.
HF_TOKEN=
